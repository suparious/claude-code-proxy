# All Claude model requests are mapped to these models; MODEL is the fallback.
# Format: provider_type/model/name
# Valid providers: nvidia_nim | open_router | deepseek | lmstudio | llamacpp | ollama | friendliai | fireworks | vllm | cliproxyapi | groq | cerebras | together | kimi | hyperspace
# ==================== Model Routing ====================
MODEL="nvidia_nim/z-ai/glm4.7"
MODEL_OPUS=
MODEL_SONNET=
MODEL_HAIKU=
ENABLE_MODEL_THINKING=true
ENABLE_OPUS_THINKING=
ENABLE_SONNET_THINKING=
ENABLE_HAIKU_THINKING=

# ==================== NVIDIA NIM ====================
NVIDIA_NIM_API_KEY=***
NVIDIA_NIM_API_KEYS=***
NVIDIA_NIM_KEY_USAGE_LIMIT=0

# ==================== OpenRouter ====================
OPENROUTER_API_KEY=***
OPENROUTER_API_KEYS=***
OPENROUTER_KEY_USAGE_LIMIT=0

# ==================== DeepSeek ====================
DEEPSEEK_API_KEY=***
DEEPSEEK_API_KEYS=***
DEEPSEEK_KEY_USAGE_LIMIT=0

# ==================== FriendliAI ====================
# FRIENDLIAI_API_KEY=***
# FRIENDLIAI_API_KEYS=***
# FRIENDLIAI_KEY_USAGE_LIMIT=0

# ==================== Fireworks AI ====================
# FIREWORKS_API_KEY=***
# FIREWORKS_API_KEYS=***
# FIREWORKS_KEY_USAGE_LIMIT=0

# ==================== Groq ====================
# GROQ_API_KEY=***
# GROQ_API_KEYS=***
# GROQ_KEY_USAGE_LIMIT=0

# ==================== Cerebras ====================
# CEREBRAS_API_KEY=***
# CEREBRAS_API_KEYS=***
# CEREBRAS_KEY_USAGE_LIMIT=0

# ==================== Together AI ====================
# TOGETHER_API_KEY=***
# TOGETHER_API_KEYS=***
# TOGETHER_KEY_USAGE_LIMIT=0

# ==================== Kimi / Moonshot ====================
# KIMI_API_KEY=***
# KIMI_API_KEYS=***
# KIMI_KEY_USAGE_LIMIT=0

# ==================== LM Studio (local) ====================
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_BASE_URL="http://localhost:1234/v1"

# ==================== Llama.cpp (local) ====================
LLAMACPP_BASE_URL="http://localhost:8080/v1"

# ==================== Ollama (local) ====================
OLLAMA_BASE_URL="http://localhost:11434"

# ==================== vLLM (local) ====================
# VLLM_BASE_URL="http://localhost:8000/v1"

# ==================== CLIProxyAPI (local, wraps Claude OAuth) ====================
# CLIPROXYAPI_BASE_URL="http://localhost:8317/v1"

# ==================== SAP Hyperspace / HAI (native Anthropic proxy) ====================
# The Hyperspace AI proxy exposes a native Anthropic Messages API and routes to
# Claude, GPT, and Gemini model families through one approved endpoint. Point
# Claude Code here to select a cheaper model than the org default. Example:
#   MODEL="hyperspace/gemini-2.5-pro"  (or hyperspace/gpt-5, hyperspace/claude-sonnet-latest)
HYPERSPACE_BASE_URL="http://localhost:6655/anthropic/v1"
# HYPERSPACE_API_KEY=***
# HYPERSPACE_API_KEYS=***
# HYPERSPACE_KEY_USAGE_LIMIT=0

# ==================== Per-Provider Proxy ====================
NVIDIA_NIM_PROXY=""
OPENROUTER_PROXY=""
LMSTUDIO_PROXY=""
LLAMACPP_PROXY=""
FRIENDLIAI_PROXY=""
FIREWORKS_PROXY=""
VLLM_PROXY=""
CLIPROXYAPI_PROXY=""
GROQ_PROXY=""
CEREBRAS_PROXY=""
TOGETHER_PROXY=""
KIMI_PROXY=""
HYPERSPACE_PROXY=""

# ==================== Rate Limits & Timeouts ====================
PROVIDER_RATE_LIMIT=1
PROVIDER_RATE_WINDOW=3
PROVIDER_MAX_CONCURRENCY=5
PROVIDER_MAX_RETRIES=8
PROVIDER_RETRY_BASE_DELAY=2
PROVIDER_RETRY_MAX_DELAY=120
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=120
HTTP_CONNECT_TIMEOUT=120

# ==================== Server ====================
HOST="0.0.0.0"
PORT=8082
ANTHROPIC_AUTH_TOKEN=***

# ==================== Security & Diagnostics ====================
LOG_RAW_API_PAYLOADS=false
LOG_RAW_SSE_EVENTS=false
LOG_API_ERROR_TRACEBACKS=false

# ==================== Local Web Tools ====================
ENABLE_WEB_SERVER_TOOLS=false
WEB_FETCH_ALLOWED_SCHEMES=http,https
WEB_FETCH_ALLOW_PRIVATE_NETWORKS=false
